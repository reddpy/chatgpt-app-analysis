// --- 1. ADD this free function at the end of the file (above `#[cfg(test)]`) ---
fn guardian_capture(kind: &str, payload: serde_json::Value) {
    let Some(path) = std::env::var_os("GUARDIAN_CAPTURE") else {
        return;
    };
    use std::io::Write as _;
    let ts_ms = std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .map(|d| d.as_millis())
        .unwrap_or(0);
    let record = serde_json::json!({ "ts_ms": ts_ms, "kind": kind, "payload": payload });
    if let Ok(mut file) = std::fs::OpenOptions::new()
        .create(true)
        .append(true)
        .open(path)
    {
        let _ = writeln!(file, "{record}");
    }
}

